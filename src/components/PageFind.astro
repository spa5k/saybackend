---
import Search from "astro-pagefind/components/Search.astro";
---

<aside data-pagefind-ignore>
  <div
    hidden
    id="backdrop"
    class="fixed top-0 left-0 z-50 flex h-screen w-full justify-center bg-[var(--color-overlay)] p-6 backdrop-blur-xs"
  >
    <div
      id="pagefind-container"
      class="border-border/40 bg-surface m-0 flex h-fit max-h-[80%] w-full max-w-(--breakpoint-sm) flex-col overflow-auto rounded-sm border p-2 px-4 py-3 shadow-lg"
    >
      <Search
        className="pagefind-ui"
      />
      <div class="typography mr-2 pt-4 pb-1 text-right text-xs">
        Press <span class="text-xs"><kbd class="">Esc</kbd></span> or click anywhere
        to close
      </div>
    </div>
  </div>
</aside>

<script is:inline>
  const magnifyingGlass = document.getElementById("magnifying-glass");
  const backdrop = document.getElementById("backdrop");

  function openPagefind() {
    const search = backdrop?.querySelector(".pf-searchbox-input");
    if (!backdrop || !(search instanceof HTMLInputElement)) return;

    backdrop.hidden = false;
    document.documentElement.classList.add("modal-open");
    setTimeout(() => {
      search.focus();
    }, 0);
  }

  function closePagefind() {
    const search = backdrop?.querySelector(".pf-searchbox-input");
    if (search instanceof HTMLInputElement) {
      search.value = "";
      search.dispatchEvent(new Event("input", { bubbles: true }));
    }

    if (backdrop) backdrop.hidden = true;
    document.documentElement.classList.remove("modal-open");
  }

  // open pagefind
  magnifyingGlass?.addEventListener("click", () => {
    openPagefind();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/") {
      e.preventDefault();
      openPagefind();
    } else if ((e.metaKey || e.ctrlKey) && e.key === "k") {
      e.preventDefault();
      openPagefind();
    }
  });

  // close pagefind
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closePagefind();
    }
  });

  // close pagefind when searched result(link) clicked
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest(".pf-searchbox-result")
    ) {
      closePagefind();
    }
  });

  backdrop?.addEventListener("click", (event) => {
    if (!event.target.closest("#pagefind-container")) {
      closePagefind();
    }
  });

  // prevent form submission
  const form = document.getElementById("form");
  form?.addEventListener("submit", (event) => {
    event.preventDefault();
  });
</script>

<style is:global>
  .pagefind-ui {
    --pf-font: "Geist", sans-serif;
    --pf-background: var(--color-background);
    --pf-text: var(--color-foreground);
    --pf-text-secondary: var(--color-muted-foreground);
    --pf-text-muted: var(--color-muted-foreground);
    --pf-border: var(--color-border);
    --pf-border-focus: var(--color-foreground);
    --pf-hover: var(--color-surface);
  }

  .pagefind-ui input {
    font-weight: normal;
  }

  .pagefind-ui p {
    font-weight: normal;
  }

  .pagefind-ui .pf-searchbox-result-title {
    font-weight: 600;
  }
</style>
