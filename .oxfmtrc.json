{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "insertFinalNewline": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "worker-configuration.d.ts",
    "src/components/react",
    "src/components/ui",
    "src/content",
    ".claude"
  ]
}
