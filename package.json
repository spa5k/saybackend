{
  "name": "saybackend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/sync-outrank.mjs && vite dev --port 3000",
    "start": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node scripts/sync-outrank.mjs --required && vite build && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "verify:routes": "node scripts/verify-routes.mjs",
    "lint": "eslint",
    "format": "oxfmt && eslint --fix",
    "check": "oxfmt --check && eslint",
    "deploy": "npm run build && wrangler deploy && wrangler deploy --config wrangler.www-redirect.jsonc",
    "cf-typegen": "wrangler types",
    "sync:outrank": "node scripts/sync-outrank.mjs"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "outrank-next-js-blog": "^0.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@shikijs/rehype": "^4.6.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "oxfmt": "0.79.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "overrides": {
    "katex": "$katex",
    "minimatch": "^11.0.8"
  }
}
