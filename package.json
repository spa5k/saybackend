{
  "name": "saybackend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "node scripts/prepare-static-build.mjs && vite build && pagefind --site dist/client && node scripts/finalize-static-build.mjs",
    "preview": "vite preview",
    "verify:routes": "node scripts/verify-routes.mjs",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check . && eslint",
    "deploy": "npm run build && wrangler deploy && wrangler deploy --config wrangler.www-redirect.jsonc",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@xyflow/react": "^12.11.5",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "recharts": "^3.10.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@shikijs/rehype": "^4.4.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.9.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
